PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/games_suite
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required in production: family members enter this to create an account
# (not case-sensitive). Leave unset locally to allow open sign-up.
# FAMILY_INVITE_CODE=choose-something-memorable

# Optional: the keys that sign notifications ("someone's at your table").
# Leave unset and a pair is made and kept in the database. Make your own with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT: a mailto: or https: address.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
